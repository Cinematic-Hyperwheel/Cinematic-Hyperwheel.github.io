# Directory with movies.csv and artifact.npz. Relative paths are resolved
# against the repo root. In a container this must be the in-container path.
HYPERWHEEL_DATA_DIR=./data/ml-latest
# Docker Compose only: host directory mounted into the container.
# Not read by the backend itself.
HYPERWHEEL_DATA_HOST_PATH=./data/ml-latest

# Optional precomputed PCA cache (see tools/build_basis_cache.py and
# apps/web/README.md, "Optional: precomputed PCA cache"). Defaults to
# pca_cache.npz under HYPERWHEEL_DATA_DIR; missing file or a fingerprint
# mismatch falls back to computing the basis fresh on process start.
HYPERWHEEL_PCA_CACHE_PATH=./data/ml-latest/pca_cache.npz

# Pins BLAS/LAPACK (used by build_taste_basis's eigh call) to a single
# thread. Multi-threaded BLAS busy-spins between threads while waiting
# to synchronize, which assumes real dedicated cores; under a throttled
# CPU quota (e.g. a free-tier host limited to a fraction of one core)
# that spin-wait competes with itself for the small CPU slice actually
# granted, and can inflate basis-build time by an order of magnitude or
# more (see docs/performance.md). Leave unset on a host with real
# dedicated cores and no PCA cache in place, where multi-threaded BLAS
# is legitimately faster.
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1

# Backend (see apps/web/backend/app/config.py)
TMDB_API_KEY=
TMDB_BACKDROP_SIZE=w1280
TMDB_POSTER_SIZE=w185

# Signs issued proof-of-work challenges (see apps/web/backend/app/pow.py
# and apps/web/README.md, "Proof-of-work request gating"). Required for a
# stable multi-worker/production deployment; falls back to a random
# per-process secret otherwise.
POW_SECRET=

# Enables interactive API docs (/docs, /redoc, /openapi.json) - off by
# default (see apps/web/backend/app/config.py). Set to any non-empty
# value to turn them on for local development.
HYPERWHEEL_ENABLE_API_DOCS=false

# Frontend - baked into the static bundle at BUILD TIME (see
# apps/web/frontend/vite.config.ts). VITE_ prefix required; anything
# else in this file is never exposed to client code.
VITE_GITHUB_URL=https://github.com/<your-org>/Cinematic-Hyperwheel
VITE_AUTHOR_URL=